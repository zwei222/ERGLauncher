<UserControl x:Class="ERGLauncher.Views.SettingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:ERGLauncher.Properties"
             xmlns:views="using:ERGLauncher.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="560"
             d:DesignHeight="400">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="16">
    <StackPanel>
      <TextBlock Text="{x:Static properties:Resources.Setting}" FontSize="24" FontWeight="SemiBold" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="{x:Static properties:Resources.Generals}">
        <Grid ColumnDefinitions="*,220" RowDefinitions="Auto,Auto" Margin="16" RowSpacing="16" ColumnSpacing="20">
          <StackPanel>
            <TextBlock Text="{x:Static properties:Resources.SelectLanguage}" FontWeight="SemiBold" />
          </StackPanel>
          <ComboBox Grid.Column="1" ItemsSource="{x:Static views:SettingView.AvailableLanguages}"
                    SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding NativeName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Grid.Row="1">
            <TextBlock Text="{x:Static properties:Resources.SelectTheme}" FontWeight="SemiBold" />
          </StackPanel>
          <ComboBox Grid.Row="1" Grid.Column="1"
                    ItemsSource="{x:Static views:SettingView.AvailableThemeChoices}"
                    SelectedValueBinding="{Binding Value}"
                    SelectedValue="{Binding SelectedTheme}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{x:Static properties:Resources.Apply}" Command="{Binding ApplyAsyncCommand}" />
      <Button Content="{x:Static properties:Resources.Ok}" Command="{Binding OkAsyncCommand}" Classes="accent" />
    </StackPanel>
  </Grid>
</UserControl>
