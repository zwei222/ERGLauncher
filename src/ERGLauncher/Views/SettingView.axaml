<UserControl x:Class="ERGLauncher.Views.SettingView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:ERGLauncher.Properties"
             xmlns:views="using:ERGLauncher.Views"
             xmlns:vm="using:ERGLauncher.ViewModels"
             xmlns:globalization="using:System.Globalization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:CompileBindings="True"
             x:DataType="vm:SettingViewModel"
             d:DesignWidth="560"
             d:DesignHeight="400">
  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="20">
    <StackPanel Spacing="4">
      <TextBlock Text="{x:Static properties:Resources.Setting}" FontSize="28" FontWeight="SemiBold" />
      <Border Height="3" Width="36" HorizontalAlignment="Left" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" />
    </StackPanel>

    <TabControl Grid.Row="1">
      <TabItem Header="{x:Static properties:Resources.Generals}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid ColumnDefinitions="*,200" RowDefinitions="Auto,Auto" Margin="20" RowSpacing="20" ColumnSpacing="24">
          <StackPanel Spacing="3">
            <TextBlock Text="{x:Static properties:Resources.SelectLanguage}" FontWeight="SemiBold" />
          </StackPanel>
          <ComboBox Classes="form-control" Grid.Column="1" ItemsSource="{x:Static views:SettingView.AvailableLanguages}"
                    SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Static properties:Resources.SelectLanguage}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="globalization:CultureInfo">
                <TextBlock Text="{Binding NativeName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <StackPanel Grid.Row="1" Spacing="3">
            <TextBlock Text="{x:Static properties:Resources.SelectTheme}" FontWeight="SemiBold" />
          </StackPanel>
          <ComboBox Classes="form-control" Grid.Row="1" Grid.Column="1"
                    ItemsSource="{x:Static views:SettingView.AvailableThemeChoices}"
                    SelectedValueBinding="{Binding Value}"
                    SelectedValue="{Binding SelectedTheme}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{x:Static properties:Resources.SelectTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="views:ThemeChoice">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="dialog-control" Content="{x:Static properties:Resources.Apply}" Command="{Binding ApplyAsyncCommand}" />
      <Button Classes="dialog-control accent" Content="{x:Static properties:Resources.Ok}" Command="{Binding OkAsyncCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
