<UserControl x:Class="ERGLauncher.Views.AddProductView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:ERGLauncher.Properties"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="480"
             d:DesignHeight="500">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="20" RowSpacing="16">
    <StackPanel>
      <TextBlock Text="{x:Static properties:Resources.AddProduct}" FontSize="24" FontWeight="SemiBold" />
    </StackPanel>

    <TextBox Grid.Row="1" Text="{Binding Name}"
             Watermark="{x:Static properties:Resources.ProductName}" />

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <Image Source="{Binding Icon}" Width="96" Height="96" Stretch="Uniform" />
          <TextBlock Text="{x:Static properties:Resources.Icon}" HorizontalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Column="1" Content="{x:Static properties:Resources.OpenIconFile}"
                Command="{Binding SelectIconAsyncCommand}"
                VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <TextBox Text="{Binding Path}" Watermark="{x:Static properties:Resources.ExecutableFile}" />
      <Button Grid.Column="1" Content="{x:Static properties:Resources.OpenExecutableFile}"
              Command="{Binding SelectFileAsyncCommand}" />
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{x:Static properties:Resources.Cancel}" Command="{Binding CancelCommand}" />
      <Button Content="{x:Static properties:Resources.Save}" Command="{Binding AddProductAsyncCommand}" Classes="accent" />
    </StackPanel>
  </Grid>
</UserControl>
