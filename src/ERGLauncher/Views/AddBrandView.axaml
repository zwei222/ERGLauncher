<UserControl x:Class="ERGLauncher.Views.AddBrandView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:ERGLauncher.Properties"
             xmlns:vm="using:ERGLauncher.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:CompileBindings="True"
             x:DataType="vm:AddBrandViewModel"
             d:DesignWidth="440"
             d:DesignHeight="360">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="20">
    <StackPanel Spacing="4">
      <TextBlock Text="{x:Static properties:Resources.AddBrand}" FontSize="28" FontWeight="SemiBold" />
      <Border Height="3" Width="36" HorizontalAlignment="Left" Background="{DynamicResource AppAccentBrush}" CornerRadius="2" />
    </StackPanel>

    <TextBox Classes="form-control" Grid.Row="1" Text="{Binding Name}"
             PlaceholderText="{x:Static properties:Resources.BrandName}"
             AutomationProperties.Name="{x:Static properties:Resources.BrandName}" />

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <Image Source="{Binding Icon}" Width="104" Height="104" Stretch="Uniform"
                 AutomationProperties.Name="{x:Static properties:Resources.Icon}" />
          <TextBlock Text="{x:Static properties:Resources.Icon}" HorizontalAlignment="Center" Opacity="0.7" />
        </StackPanel>
        <Button Classes="dialog-control" Grid.Column="1" Content="{x:Static properties:Resources.OpenIconFile}"
                Command="{Binding SelectIconAsyncCommand}"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Static properties:Resources.OpenIconFile}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="dialog-control" Content="{x:Static properties:Resources.Cancel}" Command="{Binding CancelCommand}" />
      <Button Classes="dialog-control accent" Content="{x:Static properties:Resources.Save}" Command="{Binding AddBrandAsyncCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
