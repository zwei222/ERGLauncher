<Window x:Class="ERGLauncher.Views.MainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:ERGLauncher.Core"
        xmlns:properties="using:ERGLauncher.Properties"
        xmlns:views="using:ERGLauncher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:CompileBindings="True"
        x:DataType="views:IMainViewDataContext"
        d:DesignWidth="900"
        d:DesignHeight="620"
        Title="ERG Launcher"
        Icon="avares://ERGLauncher/Assets/icon.ico"
        OpenedCommand="{Binding LoadSettingAsyncCommand}"
        ClosingCommand="{Binding SaveAppSettingAsyncCommand}"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.navigation">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">
    <Border Padding="20,12"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button Classes="navigation"
                Command="{Binding BackCommand}"
                IsEnabled="{Binding IsEnabledBack}"
                ToolTip.Tip="{x:Static properties:Resources.Back}"
                AutomationProperties.Name="{x:Static properties:Resources.Back}">
          <PathIcon Width="18" Height="18" Data="M20,11 L7.83,11 13.42,5.41 12,4 4,12 12,20 13.42,18.59 7.83,13 20,13 Z" />
        </Button>
        <Button Grid.Column="1"
                Classes="navigation"
                Command="{Binding ForwardCommand}"
                IsEnabled="{Binding IsEnabledForward}"
                ToolTip.Tip="{x:Static properties:Resources.Forward}"
                AutomationProperties.Name="{x:Static properties:Resources.Forward}">
          <PathIcon Width="18" Height="18" Data="M4,11 L16.17,11 10.58,5.41 12,4 20,12 12,20 10.58,18.59 16.17,13 4,13 Z" />
        </Button>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1" Margin="12,0,0,0">
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentBrand}" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Column="3"
                Classes="toolbar"
                Command="{Binding OpenSettingCommand}"
                ToolTip.Tip="{x:Static properties:Resources.Setting}"
                AutomationProperties.Name="{x:Static properties:Resources.Setting}">
          <PathIcon Width="18" Height="18" Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.42,11.02 L21.54,9.37 L19.54,5.91 L17.04,6.91 C16.54,6.52 15.98,6.2 15.37,5.98 L15,3.32 L11,3.32 L10.63,5.98 C10.02,6.2 9.46,6.52 8.96,6.91 L6.46,5.91 L4.46,9.37 L6.58,11.02 C6.53,11.34 6.5,11.66 6.5,12 C6.5,12.34 6.53,12.66 6.58,12.98 L4.46,14.63 L6.46,18.09 L8.96,17.09 C9.46,17.48 10.02,17.8 10.63,18.02 L11,20.68 L15,20.68 L15.37,18.02 C15.98,17.8 16.54,17.48 17.04,17.09 L19.54,18.09 L21.54,14.63 Z M13,15.5 A3.5,3.5 0 1 1 13,8.5 A3.5,3.5 0 0 1 13,15.5 Z" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,12,0,0">
      <ListBox x:Name="MainListBox"
               ItemsSource="{Binding Items}"
               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
               Background="Transparent"
               BorderThickness="0"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{x:Static properties:Resources.Add}"
                      Command="{Binding AddItemAsyncCommand}"
                      ToolTip.Tip="{x:Static properties:Resources.Add}"
                      AutomationProperties.Name="{x:Static properties:Resources.Add}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:Item">
            <Border Width="156" Height="156" CornerRadius="8" Classes="card"
                    Background="{DynamicResource AppCardBrush}"
                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                    BorderThickness="1"
                    Tapped="OnItemTapped">
              <Border.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="{x:Static properties:Resources.Edit}"
                            Click="OnEditItemClick" />
                  <MenuItem Header="{x:Static properties:Resources.Remove}"
                            Click="OnRemoveItemClick" />
                </ContextMenu>
              </Border.ContextMenu>
              <Grid RowDefinitions="*,Auto">
                <Image Source="{Binding Icon}" Width="80" Height="80" Stretch="Uniform"
                       AutomationProperties.Name="{Binding Name}" />
                <TextBlock Grid.Row="1"
                           Text="{Binding Name}"
                           Margin="8,8,8,10"
                           FontSize="15"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border IsVisible="{Binding IsLoading}"
              Background="{DynamicResource AppCardBrush}"
              Opacity="0.94"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True"
                       Width="120"
                       Height="6"
                       AutomationProperties.Name="{x:Static properties:Resources.Loading}" />
          <TextBlock Text="{x:Static properties:Resources.Loading}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
