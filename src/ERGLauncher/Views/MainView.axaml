<Window x:Class="ERGLauncher.Views.MainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:ERGLauncher.Core"
        xmlns:properties="using:ERGLauncher.Properties"
        xmlns:views="using:ERGLauncher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:CompileBindings="True"
        x:DataType="views:IMainViewDataContext"
        d:DesignWidth="900"
        d:DesignHeight="620"
        Title="{Binding Title}"
        OpenedCommand="{Binding LoadSettingAsyncCommand}"
        ClosingCommand="{Binding SaveAppSettingAsyncCommand}"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.navigation">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.toolbar">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.card">
      <Setter Property="Background" Value="{DynamicResource AppCardSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible Border.card">
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Border Padding="20,16"
            Background="{DynamicResource AppCardBrush}"
            BorderBrush="{DynamicResource AppCardBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button Classes="navigation"
                Command="{Binding BackCommand}"
                IsEnabled="{Binding IsEnabledBack}"
                ToolTip.Tip="{x:Static properties:Resources.Back}"
                AutomationProperties.Name="{x:Static properties:Resources.Back}">
          <PathIcon Width="18" Height="18" Data="M20,11 L7.83,11 13.42,5.41 12,4 4,12 12,20 13.42,18.59 7.83,13 20,13 Z" />
        </Button>
        <Button Grid.Column="1"
                Classes="navigation"
                Command="{Binding ForwardCommand}"
                IsEnabled="{Binding IsEnabledForward}"
                ToolTip.Tip="{x:Static properties:Resources.Forward}"
                AutomationProperties.Name="{x:Static properties:Resources.Forward}">
          <PathIcon Width="18" Height="18" Data="M4,11 L16.17,11 10.58,5.41 12,4 20,12 12,20 10.58,18.59 16.17,13 4,13 Z" />
        </Button>
        <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="ERG Launcher" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentBrand}" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Column="3"
                Classes="toolbar"
                Command="{Binding OpenSettingCommand}"
                ToolTip.Tip="{x:Static properties:Resources.Setting}"
                AutomationProperties.Name="{x:Static properties:Resources.Setting}">
          <PathIcon Width="18" Height="18" Data="M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M4.93,4.93 L7.05,7.05 M16.95,16.95 L19.07,19.07 M19.07,4.93 L16.95,7.05 M7.05,16.95 L4.93,19.07 M2,12 L5,12 M19,12 L22,12 M12,2 L12,5 M12,19 L12,22" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CurrentBrand}" Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1"
              Classes="toolbar"
              Command="{Binding AddItemAsyncCommand}"
              ToolTip.Tip="{x:Static properties:Resources.Add}"
              AutomationProperties.Name="{x:Static properties:Resources.Add}">
        <PathIcon Width="18" Height="18" Data="M11,5 L13,5 13,11 19,11 19,13 13,13 13,19 11,19 11,13 5,13 5,11 11,11 Z" />
      </Button>
      <Button Grid.Column="2"
              Classes="toolbar"
              ToolTip.Tip="{x:Static properties:Resources.MoreActions}"
              AutomationProperties.Name="{x:Static properties:Resources.MoreActions}">
        <PathIcon Width="18" Height="18" Data="M5,10 A2,2 0 1 0 5,14 A2,2 0 1 0 5,10 M12,10 A2,2 0 1 0 12,14 A2,2 0 1 0 12,10 M19,10 A2,2 0 1 0 19,14 A2,2 0 1 0 19,10" />
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{x:Static properties:Resources.Edit}"
                      Command="{Binding EditItemAsyncCommand}" />
            <MenuItem Header="{x:Static properties:Resources.Remove}"
                      Command="{Binding RemoveItemAsyncCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <ListBox Grid.Row="2"
             Margin="20,0,0,0"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             SelectionChanged="OnListSelectionChanged"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:Item">
          <Border Width="156" Height="156" CornerRadius="8" Classes="card"
                  Background="{DynamicResource AppCardBrush}"
                  BorderBrush="{DynamicResource AppCardBorderBrush}"
                  BorderThickness="1">
            <Grid RowDefinitions="*,Auto">
            <Image Source="{Binding Icon}" Width="80" Height="80" Stretch="Uniform"
                   AutomationProperties.Name="{Binding Name}" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Name}"
                       Margin="8,8,8,10"
                       FontSize="15"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
