<Window x:Class="ERGLauncher.Views.MainView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:ERGLauncher.Core"
        xmlns:properties="using:ERGLauncher.Properties"
        xmlns:views="using:ERGLauncher.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:CompileBindings="True"
        x:DataType="views:IMainViewDataContext"
        d:DesignWidth="900"
        d:DesignHeight="620"
        Title="{Binding Title}"
        OpenedCommand="{Binding LoadSettingAsyncCommand}"
        ClosingCommand="{Binding SaveAppSettingAsyncCommand}"
        Width="900"
        Height="620"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.navigation">
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Border Padding="20,16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
        <Button Classes="navigation"
                Content="←"
                Command="{Binding BackCommand}"
                IsEnabled="{Binding IsEnabledBack}"
                ToolTip.Tip="{x:Static properties:Resources.Back}"
                AutomationProperties.Name="{x:Static properties:Resources.Back}" />
        <Button Grid.Column="1"
                Classes="navigation"
                Content="→"
                Command="{Binding ForwardCommand}"
                IsEnabled="{Binding IsEnabledForward}"
                ToolTip.Tip="{x:Static properties:Resources.Forward}"
                AutomationProperties.Name="{x:Static properties:Resources.Forward}" />
        <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
          <TextBlock Text="ERG Launcher" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentBrand}" Opacity="0.7" />
        </StackPanel>
        <Button Grid.Column="3"
                Content="{x:Static properties:Resources.Setting}"
                Command="{Binding OpenSettingCommand}"
                ToolTip.Tip="{x:Static properties:Resources.Setting}"
                AutomationProperties.Name="{x:Static properties:Resources.Setting}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding CurrentBrand}" Opacity="0.7" />
      </StackPanel>
      <Button Grid.Column="1"
              Content="{x:Static properties:Resources.Add}"
              Command="{Binding AddItemAsyncCommand}" />
      <Button Grid.Column="2"
              Content="⋯"
              ToolTip.Tip="More actions"
              AutomationProperties.Name="More actions">
        <Button.Flyout>
          <MenuFlyout>
            <MenuItem Header="{x:Static properties:Resources.Edit}"
                      Command="{Binding EditItemAsyncCommand}" />
            <MenuItem Header="{x:Static properties:Resources.Remove}"
                      Command="{Binding RemoveItemAsyncCommand}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <ListBox Grid.Row="2"
             Margin="20,0,0,0"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
             SelectionChanged="OnListSelectionChanged"
             Background="Transparent"
             BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:Item">
          <Grid Width="150" Height="150" Margin="6" RowDefinitions="*,Auto">
            <Image Source="{Binding Icon}" Width="80" Height="80" Stretch="Uniform" />
            <TextBlock Grid.Row="1"
                       Text="{Binding Name}"
                       Margin="4,10,4,8"
                       FontSize="15"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</Window>
